# Murmur reads none of these at runtime for normal use. Keys are entered in the
# app (Settings -> Language Models) and stored in the OS keychain, not here.
# This file exists for development and for anyone wiring up a provider by hand.

# ─── BYOK provider keys (all optional; only needed for the provider you use) ───

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=

# https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://tinfoil.sh/inference
TINFOIL_API_KEY=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ─── Transcription ───

# Whisper model used for cloud transcription. Local transcription picks its own
# model in Settings and ignores this.
WHISPER_MODEL=whisper-1

# Dictation language. Empty means auto-detect; otherwise a code like en, es, fr.
LANGUAGE=

# UI language (en, es, fr, de, pt, it, ja, ru, zh-CN, zh-TW).
UI_LANGUAGE=en

# ─── Development ───

# debug | info | warn | error
MURMUR_LOG_LEVEL=info
